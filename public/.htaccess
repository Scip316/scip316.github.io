<IfModule mod_headers.c>
  # Revalidate the entry page so it always references the current build.
  <Files "index.html">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </Files>

  # Unversioned images may change at the same URL.
  <FilesMatch "\.(?:webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Content-hashed bundles and generated images change URL when updated.
  <FilesMatch "(?:-[A-Za-z0-9_-]{8}\.(?:js|css)|-[a-f0-9]{16}-(?:640|1000|1280)\.webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # These are Vue routes that share names with static asset directories.
  RewriteRule ^(projects|certificates|experience|about)/?$ index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Missing build assets must not masquerade as successful HTML responses.
  RewriteRule ^(?:assets|generated-media)/ - [R=404,L]
  RewriteRule ^ index.html [L]
</IfModule>
