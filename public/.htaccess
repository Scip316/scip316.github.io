<IfModule mod_headers.c>
  # Revalidate HTML pages so they always reference the current build.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # Unversioned images may change at the same URL.
  <FilesMatch "\.(?:webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Content-hashed bundles and generated images change URL when updated.
  <FilesMatch "(?:-[A-Za-z0-9_-]{8}\.(?:js|css)|-[a-f0-9]{16}-(?:640|1000|1280)\.webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve generated page content before the shared Vue fallback.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(about|projects|certificates|experience(?:/[^/]+)?)/?$ $1.html [L]

  # These are Vue routes that share names with static asset directories.
  RewriteRule ^(projects|certificates|experience|about)/?$ index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Missing build assets must not masquerade as successful HTML responses.
  RewriteRule ^(?:assets|generated-media)/ - [R=404,L]
  RewriteRule ^ index.html [L]
</IfModule>
